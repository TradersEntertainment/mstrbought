# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here  # Channel username (e.g. @channel) or chat ID

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Admin Password Configuration (For Web Dashboard Controls)
ADMIN_PASSWORD=your_admin_password_here  # Set a password to protect "Force Check" and "Test Alert" buttons

# Database Configuration
DB_PATH=mstr_state.db  # For Railway volume mount, set this to /data/mstr_state.db

# Polling Interval Configuration (in seconds)
#
# Windows are anchored to US EASTERN, the clock EDGAR disseminates on — NOT
# to Turkish local time. Turkey is a fixed UTC+3 while ET shifts with US DST,
# so a TRT-anchored window drifts an hour twice a year: MSTR's 07:55-08:25 ET
# filing band is 14:55-15:25 TRT in summer but 15:55-16:25 TRT in winter.
#
# ULTRA_WINDOW_ET  polls at POLL_INTERVAL_CRITICAL (the filing band).
# FAST_WINDOW_ET   polls at POLL_INTERVAL_FAST (the rest of EDGAR's
#                  dissemination day, so the 16:00-17:30 ET 8-Ks are
#                  seconds late rather than minutes).
# Everything else  polls at POLL_INTERVAL_NORMAL (EDGAR is closed).
#
# Per tick: submissions (a cheap 304 when unchanged) every tick, the atom
# feed at most once per second, EFTS every 5s. At 0.25s that is ~5 req/s,
# under the SEC's 10 req/s fair-use limit.
ULTRA_WINDOW_ET=07:30-09:15
FAST_WINDOW_ET=06:00-18:00
POLL_INTERVAL_NORMAL=60
POLL_INTERVAL_CRITICAL=0.25
POLL_INTERVAL_FAST=2

# SEC request timeouts, split into (connect, read). Railway's egress to
# www.sec.gov is slow enough that a flat 3s read timed out constantly; the
# poll tick no longer blocks on these, so a longer read is safe and a fetch
# that outruns one tick is delivered on the next.
SEC_CONNECT_TIMEOUT=2
SEC_READ_TIMEOUT=6

# Telegram renders a link preview by fetching the SEC page itself before it
# answers sendMessage, and every filing URL is a cache miss for it — that
# wait lands on the alert path. Set to true to trade latency for the card.
TELEGRAM_LINK_PREVIEW=false

# Dividend Model Configuration
# Baseline = outstanding face value ($M) of each preferred series BEFORE the
# tracked ATM data window begins (read them from the latest 10-Q).
# 0 = model only counts ATM sales observed by this bot.
PREFERRED_BASELINE_AS_OF=2026-02-01
STRF_BASELINE_M=0
STRK_BASELINE_M=0
STRD_BASELINE_M=0
STRC_BASELINE_M=0
# STRC pays a variable monthly rate announced by MSTR — keep this current
STRC_ANNUAL_RATE=0.10
# Euro-denominated preferred series (STRE) are converted to USD at this rate
# when the 10-Q preferred table is parsed for the annual-dividend figure
EURUSD_RATE=1.08

# Strategy's own published figures from strategy.com (ground truth).
# The USD Reserve becomes the newest cash anchor and the runway basis; the
# annual dividends and total pref feed the dividend model. These also update
# live via POST /api/official?password=...&asof=YYYY-MM-DD&usd_reserve_m=...
STRATEGY_ASOF=2026-07-13
STRATEGY_USD_RESERVE_M=3000
STRATEGY_ANNUAL_DIVIDENDS_M=1763
STRATEGY_PREF_M=15464
STRATEGY_DEBT_M=6754
